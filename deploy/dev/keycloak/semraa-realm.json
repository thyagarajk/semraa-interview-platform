{
  "realm": "semraa",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and notUsername",
  "roles": {
    "realm": [
      { "name": "super-admin", "description": "Platform: Semraa super admin" },
      { "name": "support", "description": "Platform: read-only, time-boxed, audited" },
      { "name": "finance-verifier", "description": "Platform: verifies manual payments" }
    ]
  },
  "clientScopes": [
    {
      "name": "semraa-api-audience",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "semraa-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "semraa-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "semraa-api",
      "name": "Semraa API (resource server)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "semraa-candidate",
      "name": "Semraa Candidate / B2C app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:4200/*" },
      "defaultClientScopes": ["openid", "profile", "email", "roles", "semraa-api-audience"]
    },
    {
      "clientId": "semraa-college",
      "name": "Semraa College app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4201/*"],
      "webOrigins": ["http://localhost:4201"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:4201/*" },
      "defaultClientScopes": ["openid", "profile", "email", "roles", "semraa-api-audience"]
    }
  ]
}
